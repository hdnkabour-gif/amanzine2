# ============================================================
# AI Commerce OS — Configuration
# Copy this file to .env and fill your values
# ============================================================

# ── Database — REQUIRED for data persistence ─────────────────
# PostgreSQL connection string (Railway/Supabase provide this automatically)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aicommerce
#
# ── TLS/SSL to the database ──────────────────────────────────
# The server verifies the database server's IDENTITY for any remote DB:
# ssl = { rejectUnauthorized: true }. Encryption without identity protects
# against a passive eavesdropper only, never against an interceptor.
#
# This means a provider presenting a self-signed certificate FAILS to
# connect — on purpose. You will see:
#   error: self-signed certificate in certificate chain
#   DB migration failed — starting in degraded mode  →  /api/health = 503
# A declared failure beats a link that looks safe and is not.
#
# Pick exactly ONE of the following. They are mutually exclusive and
# combining them is rejected with an explicit error, never silently.
#
#   DATABASE_CA=<PEM text>       # strict verification with your provider's CA
#   PGSSLROOTCERT=/path/ca.pem   # same, from a file
#   PGSSLMODE=disable            # local development ONLY — throws for a
#                                #   remote DB when NODE_ENV=production
#   DB_TRANSPORT=railway-private # Railway PRIVATE Postgres — see below
#
# ── Railway private PostgreSQL ───────────────────────────────
# Railway's private network is already encrypted (WireGuard) and isolated
# per environment, and its Postgres certificate is signed by a self-signed
# root whose name does not match the *.railway.internal host. So strict
# verification cannot succeed there, and DATABASE_CA alone does NOT fix it
# (the chain verifies, then the hostname check fails).
#
# For that topology only, declare the transport:
#   DB_TRANSPORT=railway-private
#
# Accepted ONLY when ALL of these hold — otherwise it throws and says why:
#   1. NODE_ENV=production
#   2. DB_TRANSPORT=railway-private
#   3. RAILWAY_ENVIRONMENT_ID present (Railway injects it — never fake it;
#      it is the only proof that does not come from the file claiming it)
#   4. DATABASE_URL host ends exactly in .railway.internal
#   5. no DATABASE_CA / PGSSLROOTCERT / DATABASE_CA_PATH set alongside
#   6. no PGSSLMODE=disable / DB_SSL=false / sslmode=disable alongside
#
# If the database ever moves OFF Railway, delete DB_TRANSPORT. It is a
# contract with Railway's topology alone; elsewhere strict TLS is correct.
# Details: REPORTS/REPAIRS/RAILWAY_STAGING_PLAN.md §③ب

# ── Web Push / VAPID keys ────────────────────────────────────
# Generate once: node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k)"
# Then copy here to persist across Railway deploys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# PRODUCTION_URL=https://yourdomain.com

# JWT — REQUIRED: generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE-THIS-TO-A-RANDOM-STRING-MIN-32-CHARS

# ── AI (Optional — app works without these) ─────────────────

# OpenAI (for smart AI replies in Arabic/Darija)
OPENAI_API_KEY=sk-...

# Google Gemini (free alternative to OpenAI)
GEMINI_API_KEY=AIzaSy...

# ── Meta / WhatsApp (Optional) ───────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=my-webhook-verify-token-123
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Cloudinary — image uploads (Required for persistent storage on Railway) ──
# Sign up free at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Delivery Providers API (Optional — configure in dashboard) ──
# These are set per-provider inside the app's Delivery page,
# but can be pre-set as env vars for server-side defaults.
#
# Amana (Maroc Telecom delivery)
# AMANA_API_KEY=
# AMANA_API_ENDPOINT=api.amana.ma
#
# Jibli delivery
# JIBLI_API_KEY=
#
# Generic webhook — receives order data when shipment is created
# DELIVERY_WEBHOOK_SECRET=

# ── Auto-create admin on first start (Optional) ──────────────
ADMIN_EMAIL=admin@mystore.ma
ADMIN_PASSWORD=Admin1234!
ADMIN_NAME=المدير

# ── Marketplace (السوق الموحّد) — Optional ───────────────────
# Only this account can moderate marketplace ads. Falls back to ADMIN_EMAIL.
# PLATFORM_ADMIN_EMAIL=
#
# Platform-level WhatsApp sender for quick-seller phone verification (OTP).
# When BOTH are set, publishing an ad requires confirming the seller's phone
# via a WhatsApp code. Leave empty to disable verification (submit works as-is).
# PLATFORM_WHATSAPP_TOKEN=
# PLATFORM_WHATSAPP_PHONE_ID=

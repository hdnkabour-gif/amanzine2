# lucide-react@0.383 يُصرِّح بأعلى توافقٍ عند React 18، والمشروع على React 19.
# بدون هذا السطر يفشل `npm install` محلّيًّا بـ ERESOLVE، بينما ينجح النشر لأنّ
# nixpacks.toml و railway.json يمرّران --legacy-peer-deps صراحةً. توحيدُ السلوك
# هنا يمنع «يعمل عند النشر ولا يعمل عندي».
legacy-peer-deps=true

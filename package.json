{
  "name": "amanzine",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postinstall": "cd server && npm install",
    "start": "node server/index.js",
    "lint": "tsc --noEmit",
    "test:brain": "node scripts/run-brain-tests.mjs",
    "test:constitution": "node --test test/constitution.test.mjs test/theme.test.mjs",
    "test:knowledge": "node --test test/knowledge-health.test.mjs",
    "sabotage": "node scripts/sabotage.mjs",
    "test:architecture": "node --test test/architecture.test.mjs test/architecture-freshness.test.mjs test/abilities.test.mjs test/pageActions.test.mjs test/normalize-source.test.mjs test/pulse.test.mjs test/disconnected.test.mjs test/lexicon.test.mjs test/askKind.test.mjs",
    "audit:knowledge": "node scripts/knowledge-audit.mjs",
    "gen:variants": "node scripts/knowledge-audit.mjs --emit-index",
    "gen:cities": "node scripts/emit-cities.mjs",
    "report:page-actions": "node scripts/pageActions.mjs",
    "report:lexicon": "node scripts/lexicon.mjs",
    "test": "npm run test:brain && npm run test:constitution && npm run test:knowledge && npm run test:architecture && cd server && npm test",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\" \"server/**/*.js\"",
    "pulse": "node scripts/run-pulse.mjs",
    "report:disconnected": "node scripts/disconnected.mjs",
    "report:ask-kind": "node scripts/run-askKind.mjs",
    "audit:repo": "node scripts/audit.mjs",
    "walk": "node test/browser/walk.mjs",
    "journey": "node test/browser/journey.mjs",
    "pipeline": "node test/browser/pipeline.mjs",
    "screens": "node test/browser/screens.mjs",
    "film": "node test/browser/film.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.383.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright": "^1.62.1"
  }
}
